if SHIELD_CROSSES_DONGLE

config ZMK_KEYBOARD_NAME
	default "Crosses"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_SPLIT
	default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 2

config BT_MAX_CONN
	default 7

config BT_MAX_PAIRED
	default 7

endif

if SHIELD_CROSSES_RIGHT

config ZMK_KEYBOARD_NAME
	default "Crosses"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

endif

if SHIELD_CROSSES_LEFT || SHIELD_CROSSES_RIGHT || SHIELD_CROSSES_DONGLE

config ZMK_SPLIT
	default y

endif


#include <dt-bindings/zmk/matrix_transform.h>
#include "viginti-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &viginti_physical_layout;
    };

    /* battery monitor */
    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <3>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)                    RC(0,8)  RC(0,9)  RC(0,10)  RC(0,11)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)                    RC(1,8)  RC(1,9)  RC(1,10)  RC(1,11)
                                   RC(2,4)  RC(2,5)      RC(2,6)  RC(2,7)
        >;
    };

    kscan0: kscan {
        wakeup-source;
        diode-direction = "col2row";
    };
};

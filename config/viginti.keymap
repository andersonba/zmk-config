// Viginti — 20-key split (2x4+2 per side).
//
// Too small for the shared 34-key logic in base.dtsi, so this board keeps its
// own layers: each alpha layout is split across a home layer and a shift layer
// (momentary, on the right inner thumb). QWERTY is the default and Gallium is
// toggled on from Nav, same as the other boards.
// TODO: align Num/Sym/Nav with the base.dtsi layers.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <zmk-helpers/helper.h>

#include "./macros.dtsi"

// Layers
#define BASE1 0
#define BASE2 1
#define ALPHA1 2
#define ALPHA2 3
#define NUM 4
#define SYM 5
#define NAV 6

#define ALPHAS BASE1 BASE2 ALPHA1 ALPHA2
#define ALPHA_HOMES BASE1 ALPHA1

// Timings
#define QUICK_TAP_MS 140
#define HRM_TAPPING_TERM 160
#define HRM_FAST_TAPPING_TERM 150
#define COMBO_TERM_FAST 35
#define COMBO_IDLE_FAST 100

/*                KEY POSITIONS
 * ╭─────────────────╮ ╭─────────────────╮
 * │ LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 │  <- home row
 * │ LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 │
 * ╰───────╮ LH1 LH0 │ │ RH0 RH1 ╭───────╯
 *         ╰─────────╯ ╰─────────╯
 */
#define LM3  0
#define LM2  1
#define LM1  2
#define LM0  3
#define RM0  4
#define RM1  5
#define RM2  6
#define RM3  7
#define LB3  8
#define LB2  9
#define LB1 10
#define LB0 11
#define RB0 12
#define RB1 13
#define RB2 14
#define RB3 15
#define LH1 16
#define LH0 17
#define RH0 18
#define RH1 19

#define XXX &none
#define ___ &trans

#define ZMK_VIGINTI_LAYER(name, LM, RM, LB, RB, LH, RH) \
ZMK_LAYER(name, \
  LM RM \
  LB RB \
  LH RH \
)

&lt { // Layer Tap
  tapping-term-ms = <HRM_TAPPING_TERM>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

// HRMs (no positional hold-trigger: home row is the top row here)
ZMK_HOLD_TAP(hm_mid,
  bindings = <&kp>, <&kp>;
  flavor = "tap-preferred";
  tapping-term-ms = <HRM_TAPPING_TERM>;
  quick-tap-ms = <QUICK_TAP_MS>;
)

ZMK_HOLD_TAP(hm_fast,
  bindings = <&kp>, <&kp>;
  flavor = "tap-preferred";
  tapping-term-ms = <HRM_FAST_TAPPING_TERM>;
  quick-tap-ms = <QUICK_TAP_MS>;
)

// Combos (same finger pairs and layer reach as combos.dtsi on the 34-key boards)
ZMK_COMBO(l_esc,      &kp ESC,        LM1 LM2, ALPHAS SYM,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(l_tab,      &kp TAB,        LM0 LM1, ALPHAS SYM,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(r_enter,    &kp ENTER,      RM0 RM1, ALPHAS NUM,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(r_esc,      &kp ESC,        RM1 RM2, ALPHAS NUM,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(r_bkp,      &kp BACKSPACE,  RB0 RB1, ALPHAS NUM SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(r_bkp_word, &kp RA(BSPC),   RB1 RB2, ALPHAS NUM SYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(caps,       &kp CAPS,       LM1 RM1, ALPHAS,         COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(l_nav,      &mo NAV,        LH1 RH1, ALPHA_HOMES,    COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* symbols: both chars + cursor inside (vertical combos, right hand)
 * — the 34-key boards use the inner columns for these; here the free
 *   vertical pairs (home+bottom, same finger) take that role */
ZMK_COMBO(both_par, &both_par, RM0 RB0, ALPHAS, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(both_brk, &both_brk, RM1 RB1, ALPHAS, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(both_brc, &both_brc, RM2 RB2, ALPHAS, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// LAYERS {{{
#define QMARK_EXCL &qmark_excl
#define DOT_COLON &dot_colon
#define COMMA_SEMI &comma_semicolon

ZMK_VIGINTI_LAYER(Base1, // QWERTY (home + bottom rows)
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &hm_mid LCMD A      &hm_fast LALT S     &hm_fast LSHFT D    &hm_fast LCTRL F  ,   &hm_fast RCTRL J    &hm_fast RSHFT K    &hm_mid RALT L      &hm_mid RCMD SQT  ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &kp Z               &kp X               &kp C               &kp V             ,   &kp M               COMMA_SEMI          DOT_COLON           QMARK_EXCL        ,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            &mo NUM             &kp LSHFT         ,   &mo BASE2           &lt SYM SPACE
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)

ZMK_VIGINTI_LAYER(Base2, // QWERTY (top row + inner column via layer shift)
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &kp Q               &kp W               &kp E               &kp R             ,   &kp U               &kp I               &kp O               &kp P             ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &kp T               &kp G               &kp B               &kp LSHFT         ,   &kp RSHFT           &kp N               &kp H               &kp Y             ,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            ___                 ___               ,   ___                 ___
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)

ZMK_VIGINTI_LAYER(Alpha1, // Gallium v1 (home + bottom rows)
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &hm_mid LCMD N      &hm_fast LALT R     &hm_fast LSHFT T    &hm_fast LCTRL S  ,   &hm_fast RCTRL H    &hm_fast RSHFT A    &hm_mid RALT E      &hm_mid RCMD I    ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &kp X               &kp Q               &kp M               &kp W             ,   &kp F               &kp SQT             &kp SEMI            DOT_COLON         ,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            &mo NUM             &kp LSHFT         ,   &mo ALPHA2          &lt SYM SPACE
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)

ZMK_VIGINTI_LAYER(Alpha2, // Gallium v1 (top row via layer shift)
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &kp B               &kp L               &kp D               &kp C             ,   &kp Y               &kp O               &kp U               COMMA_SEMI        ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &kp V               &kp G               &kp Z               &kp LSHFT         ,   &kp RSHFT           &kp K               &kp P               &kp J             ,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            ___                 ___               ,   ___                 ___
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)

ZMK_VIGINTI_LAYER(Num,
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &kp F8              &kp N7              &kp N8              &kp N9            ,   &kp N4              &kp N5              &kp N6              &hm_fast F12 F10  ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &kp F7              &hm_fast F4 F1      &hm_fast F5 F2      &hm_fast F6 F3    ,   &kp N1              &kp N2              &kp N3              &hm_fast F11 F9   ,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            ___                 ___               ,   &kp N0              ___
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)

// Mirrors the base.dtsi Sym structure: held mods on the left symbols,
// arrows on the right home row, bracket pairs on the right bottom row.
// @ # $ % ^ ! stay reachable as shifted digits on the Num layer;
// shift also covers ~ (`), | (\) and + (=) natively.
ZMK_VIGINTI_LAYER(Sym,
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &hm_mid LGUI TILDE  &hm_mid LALT BSLH   &hm_mid LSHFT SLASH &hm_mid LCTRL AMPS,   &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT         ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &kp GRAVE           &kp LT              &kp GT              &kp ASTRK         ,   &hm_fast LBRC LBKT  &kp LPAR            &kp RPAR            &hm_fast RBRC RBKT,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            &kp UNDERSCORE      &kp MINUS         ,   &kp EQUAL           ___
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)

ZMK_VIGINTI_LAYER(Nav,
//╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮ ╭───────────────────┬───────────────────┬───────────────────┬───────────────────╮
    &tog ALPHA1         &kp C_MUTE          &kp C_VOL_UP        &kp C_PP          ,   &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &bt BT_CLR        ,
//├───────────────────┼───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┼───────────────────┼───────────────────┤
    &bootloader         &kp C_PREV          &kp C_VOL_DN        &kp C_NEXT        ,   &lock               XXX                 XXX                 &bootloader       ,
//╰───────────────────┴───────────────────┼───────────────────┼───────────────────┤ ├───────────────────┼───────────────────┴───────────────────┴───────────────────╯
                                            ___                 ___               ,   ___                 ___
//                                        ╰───────────────────┴───────────────────╯ ╰───────────────────┴───────────────────╯
)
// }}}
